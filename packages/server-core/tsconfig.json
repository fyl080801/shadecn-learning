{
  /*
   * 服务端底座（docs/28 §3.1.1）：HTTP 管线、配置、数据库、日志、前端托管、平台能力的实现、模块的装配与启动。它不认识任何模块，清单由入口交进来。
   * 纯服务端：apps/server 以源码形式 import，再由 esbuild 内联进 bundle。
   * 配置照 apps/server / packages/agent 的来（Node 类型 + ES2023）。**它不 import apps/server，也不 import 任何模块包**；配置从环境变量和配置文件读（它就是配置层）。
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server-core.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
