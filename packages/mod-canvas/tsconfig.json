{
  /*
   * 画布模块（docs/28 §3.1）：项目、成员、邀请、画布元数据与内容存取。随所有角色加载，REST 只归 web。
   * 纯服务端：apps/server 以源码形式 import，再由 esbuild 内联进 bundle。
   * 配置照 apps/server / packages/agent 的来（Node 类型 + ES2023）。**它不 import apps/server，也不读 process.env；底座的东西只经 @shadecn/server-kit（平台能力、数据库、内核）拿**。
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mod-canvas.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
