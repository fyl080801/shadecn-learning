# 复制成 .env 后按需改。server/config.ts 会在启动时用 process.loadEnvFile() 读它。

# ---- 服务 ----
# PORT=3000
# HOST=127.0.0.1
# 生产模式吐哪个目录的静态资源。默认是 `pnpm build` 的前端产物 output/public，
# 相对路径以「应用根目录」为准（源码运行是仓库根，构建产物运行是进程 cwd）。
# STATIC_DIR="output/public"

# ---- 日志（winston）----
# 日志是「注入」上去的，业务代码里没有一句 logger 调用：console.* 被接管，
# `console.log('[collab] …')` 里的方括号前缀会变成结构化的 module 字段。
# 要加日志继续写 console.*，不用 import 任何东西（见 server/logger/）。
#
# error | warn | info（默认）| debug。debug 会打出每条 SQL、每次落库、每次握手，
# 是排查时临时开的档位，别在生产长期开着。
# LOG_LEVEL="info"
# pretty（开发默认，给人看的带色单行）| json（生产默认，一行一个对象，给采集器）
# LOG_FORMAT="pretty"
# 除了 stdout 再写一份文件到这个目录（app.log + error.log，10MB × 5 轮转）。
# **容器里不要开**：k8s 收的是 stdout，写进容器层的文件会随 Pod 一起消失。
# LOG_DIR="logs"
# 请求日志记到什么程度：api（默认，只记 /api/*，外加任何路径上的失败和慢请求）
# | all（连静态资源也记，dev 下一次刷新几百行）| off
# LOG_HTTP="api"
# 超过多少毫秒的请求单独记一条 warn
# LOG_SLOW_MS=1000
# 超过多少毫秒的数据库查询记一条 warn。0 = 不记
# LOG_SLOW_QUERY_MS=200

# ---- 数据库（MikroORM）----
# 支持 sqlite（默认，零外部依赖）和 postgresql 两种。只决定运行时加载哪个驱动 ——
# 实体定义、构建产物、镜像都和它无关，同一个产物两种库都能连。
# 不设就按 DATABASE_URL 的协议推断：file: → sqlite，postgres(ql):// → postgresql，
# 两个都没有就是 sqlite。显式设了就以它为准，和连接串协议对不上会直接启动失败。
# DB_PROVIDER="sqlite"

# --- sqlite ---
# 运行时数据目录，SQLite 库默认落在 $DATA_DIR/app.db。
# 相对路径以「仓库根目录」为准（不是 cwd），绝对路径直接用。
# 容器里就是靠它把库指到挂载卷上，例如 DATA_DIR=/app/data
# DATA_DIR="data"
# 想整个换掉库文件位置就设这个，优先级高于 DATA_DIR
# DATABASE_URL="file:./data/app.db"

# --- postgresql ---
# 换库就改这两行，然后 `pnpm db:push` 建表（`pnpm dev` 本来也会先跑它）。
# `?schema=public` 可带可不带（不带就是 public）
# DB_PROVIDER="postgresql"
# DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?schema=public"

# --- 后端测试跑在哪个库上 ---
# 不设就是 SQLite（data/test/app.db，每轮整个删掉重建），跟开发库永远不会互相影响。
#
# 想让后端测试也在 PostgreSQL 上跑，就指向一个**专用测试库**。
#
# 整轮测试开始前会对它跑一次「清空重建」（db/sync-cli.ts --reset）：实体对应的表先删光再建，
# 库里实体之外的表也会被删掉 —— 所以只能指专用测试库，别指开发库更别指生产库。
# 设了之后想临时跑 SQLite：`TEST_DATABASE_URL= pnpm test:server`
# 建库：podman exec shadecn-postgres psql -U app -d postgres -c 'CREATE DATABASE app_test OWNER app'
# TEST_DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app_test?schema=public"

# ---- 副本模式（单副本 / 多副本）----
# 单副本（默认）：什么都不用配。共享状态（审计 seq、配额标记、awareness 的 clientID
# 归属、会话刷新互斥）全在进程内存里，一行 Redis 代码都不会加载。
#
# 多副本：这些状态改走 Redis，Yjs 房间的内容和 awareness 也经 Redis pub/sub
# 在实例之间同步，落库由分布式锁去重（同一房间同一时刻只有一个实例真的写）。
#
# 不设 CLUSTER_MODE 就按 REDIS_URL 有没有推断；显式设了以它为准
# （配着 REDIS_URL 也能强制按 single 跑）。说要 redis 却没有 REDIS_URL 直接启动失败。
# CLUSTER_MODE="single"
# REDIS_URL="redis://127.0.0.1:6379"
# 多个环境共用一台 Redis 时用它隔离键空间
# REDIS_KEY_PREFIX="shadecn"
# 这个进程的身份。awareness 的归属登记要靠它区分「哪个实例的哪条连接」——
# socketId 只在单进程里唯一，多副本下不带前缀会撞号。
# 不设会按 hostname + 随机串生成；k8s 里建议注入 metadata.name
# INSTANCE_ID=""
#
# 真跑多副本还要把库换成 PostgreSQL（见上面的数据库段）：SQLite 是单文件，
# 多个进程/Pod 共享不了。开发环境只警告不拦 —— 本地拿 SQLite + Redis 单进程
# 验证 Redis 那条链路是合理的调试姿势；生产则直接拒绝启动。

# ---- 本地依赖服务（自己起，不走脚本）----
# podman run -d --name shadecn-redis -p 127.0.0.1:6379:6379 redis:7-alpine
# podman run -d --name shadecn-postgres -p 127.0.0.1:5432:5432 \
#   -e POSTGRES_USER=app -e POSTGRES_PASSWORD=app -e POSTGRES_DB=app postgres:17-alpine
# docker 换掉 podman 即可。停：podman stop shadecn-redis shadecn-postgres
#
# 切到 PostgreSQL 之后先 `pnpm db:push` 建表（没有任何生成步骤，切回 sqlite 也一样）。

# ---- 本地跑多副本 ----
# `pnpm dev:cluster` 按这个列表拉起多个实例，每个一个端口，其余配置全实例共用。
# DEV_CLUSTER_PORTS="3000,3001"
# 本地多副本时把下面的 APP_ORIGIN 注释掉，让它按各实例自己的端口推导，
# 否则 3001 上登录会跳回 3000（或者把两个端口都写进 APP_ORIGINS）。用 Keycloak 的话，
# 两个端口的 /api/auth/callback 都要加进 client 的合法回调，或者干脆不配 Keycloak 裸跑。

# ---- 登录方式 ----
# 至少配一个（Keycloak 或 GitHub），一个都不配就整站按匿名放行（仅限非生产）。
# 两个都配的话，登录页上会并排出现两个入口，用户还能在设置页里把两边关联到同一个账号。

# ---- Keycloak ----
# realm 的 issuer 地址，即 {keycloak}/realms/{realm}
# 服务端会去 $KEYCLOAK_ISSUER/.well-known/openid-configuration 拉端点
KEYCLOAK_ISSUER="http://localhost:8080/realms/myrealm"
KEYCLOAK_CLIENT_ID="shadcn-learning"
# confidential client 的密钥；public client（PKCE-only）留空即可
KEYCLOAK_CLIENT_SECRET=""
# 申请的 scope，openid 必须有
KEYCLOAK_SCOPE="openid profile email"

# ---- GitHub OAuth App ----
# https://github.com/settings/developers → New OAuth App
# Authorization callback URL 填 $APP_ORIGIN/api/auth/callback（和 Keycloak 共用同一个回调）。
# 两个都要填：GitHub 的 OAuth App 一定是 confidential client，没有 secret 换不了 token。
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# 只要读身份就够了：read:user 拿档案，user:email 拿主邮箱（用户可能把邮箱设为私密）
# GITHUB_SCOPE="read:user user:email"

# 应用自己的对外地址，用来拼 redirect_uri（= $APP_ORIGIN/api/auth/callback）。
# 它同时是下面那份白名单的默认成员，也是认不出访问域名时的回落值。
APP_ORIGIN="http://127.0.0.1:3000"

# 允许的对外域名白名单（逗号或空白分隔），APP_ORIGIN 自动在内。
#
# 同一套部署挂在多个域名下时才需要（内网域名 / 外网域名 / 老域名 / 裸 IP）。
# 配上之后，OAuth 的 redirect_uri、CORS、WebSocket 的 Origin 校验、分享链接、
# cookie 的 Secure 标记，全都按**这次访问用的域名**来算 —— 从哪个域名进来就回到
# 哪个域名，不会再被甩到 APP_ORIGIN 上（会话 cookie 也就不会种错地方）。
#
# 名单之外的 Host 一律回落 APP_ORIGIN：反代后面的 Host / X-Forwarded-Host 是外部
# 可控的输入，跟着它拼 redirect_uri 就等于把授权码送去攻击者的域名。
#
# **不支持通配符**：每个域名的 /api/auth/callback 都得在 Keycloak client 的
# Valid redirect URIs 里注册（GitHub OAuth App 只能填一个回调，多域名要么分开建
# App，要么把 GitHub 的入口固定在 APP_ORIGIN 上）。
# APP_ORIGINS="https://app.example.com,https://app.internal.example.com"

# 会话 cookie 的签名密钥，生产必须设成随机串：openssl rand -hex 32
SESSION_SECRET="dev-only-change-me"
# 会话最长存活时间（秒），默认 7 天
# SESSION_TTL=604800

# ── 画布 Agent（REQ-AGENT，docs/20-agent-canvas.md）────────────────────────────
# 全部可选。拿不到模型或 key 时 agent 不启用（画布上的面板只显示说明），不影响启动。
#
# 提供方与模型：pi（@earendil-works/pi-ai）注册表里的 id。默认 anthropic / claude-sonnet-4-6。
# AGENT_PROVIDER="anthropic"
# AGENT_MODEL="claude-sonnet-4-6"
#
# key：给了 AGENT_API_KEY 就用它；否则读该提供方自己的变量（表在 apps/server/config.ts 的 AGENT_PROVIDER_KEY_ENV）
# （anthropic → ANTHROPIC_OAUTH_TOKEN / ANTHROPIC_API_KEY，openai → OPENAI_API_KEY，deepseek → DEEPSEEK_API_KEY …；ollama 不要 key）。
# AGENT_API_KEY=""
# ANTHROPIC_API_KEY=""
#
# OpenAI 兼容端点 / 代理：同时给 BASE_URL 和 API（openai-completions | anthropic-messages），
# 此时 AGENT_PROVIDER 只当名字用，AGENT_MODEL 原样发给端点。
# AGENT_BASE_URL="http://127.0.0.1:11434/v1"
# AGENT_API="openai-completions"
#
# 模型吃不吃图片（1 / 0）：吃图片的模型才拿得到 view_node_media（看节点上的图 / 视频预览图，
# 只读本服务 S3 里的素材，所以还要配好下面的 S3_*）。不配按 pi 注册表；自建端点和 ollama 默认只吃文字，
# 多模态端点要显式配 1。
# AGENT_IMAGE_INPUT=1
#
# 本机 ollama（内置预设，不要 key；本地模型和 `:cloud` 云模型都行，名字照 `ollama list`）。
# 地址默认 http://127.0.0.1:11434/v1，ollama 在别处时用 AGENT_BASE_URL 覆盖。
# AGENT_PROVIDER="ollama"
# AGENT_MODEL="deepseek-v4.1-flash:1017-cloud"
#
# 沙箱驱动（docs/22-agent-sandbox.md §7）：agent 的推理循环（pi）跑在每轮一个的沙箱里（runner），
# 只经网关 /api/agent-gateway/* 和服务端说话；沙箱的环境变量只有网关地址、一次性凭证、工作目录和 PATH，
# LLM key / 数据库 / 会话密钥一个都没有（key 由网关的模型代理注入）。工作目录在 $DATA_DIR/agent-workspaces。
# - process（默认）：本机 node 子进程。⚠️ **不是强隔离**（同一个用户、同一个文件系统、可以出网），
#   NODE_ENV=production 时拒绝启用（agent 未启用并写明原因），除非显式 AGENT_SANDBOX_ALLOW_PROCESS=1。
# - oci：每轮一个 Docker / Podman 容器（只读根、tmpfs 工作目录、非 root、CapDrop ALL、no-new-privileges、资源上限），
#   生产可用。镜像先构建：pnpm build:sandbox-image（基础镜像 / 代理用 --build-arg 指定，见 docs/22 §7.3）。
# - k8s：每轮一个 Pod（不挂 SA token、只读根、内存型 emptyDir、requests = limits、activeDeadlineSeconds），生产可用。
#   当前部署：沙箱 Pod 建在 dev（k8s/agent-sandbox.yaml）+ 集群级 VAP 兜底（k8s/variants/agent-sandbox-vap.yaml）；
#   更强的形态是独立命名空间 + Pod Security restricted（k8s/variants/agent-sandbox.yaml）。网络隔离靠 NetworkPolicy，见 docs/22 §7.5。
# 一期的取值 local 当作 process + AGENT_SANDBOX_EXEC=1 处理。
# AGENT_SANDBOX="process"
# AGENT_SANDBOX_ALLOW_PROCESS=1
#
# oci 驱动（docs/22 §7.2）：
# 镜像（不会自动拉取）
# AGENT_SANDBOX_IMAGE="shadecn-agent-sandbox:latest"
# 容器引擎的 unix socket。不配按常见位置找：DOCKER_HOST(unix://) → /var/run/docker.sock → Linux podman → macOS podman machine
# （podman machine inspect 的 ConnectionInfo.PodmanSocket.Path）→ Docker Desktop；找不到 = agent 未启用并写明原因。
# AGENT_SANDBOX_OCI_SOCKET="/var/run/docker.sock"
# 容器进哪个网络。默认 bridge **可以出网**（启动时告警）；只有 --internal 网络且服务端也接在里面，沙箱才只连得到网关（docs/22 §7.4）。
# AGENT_SANDBOX_OCI_NETWORK="bridge"
# OCI 运行时，Linux 上装了 gVisor 时用 runsc；不配用引擎默认。
# AGENT_SANDBOX_RUNTIME="runsc"
# k8s 驱动（docs/22 §7.5）：镜像用上面的 AGENT_SANDBOX_IMAGE（集群里写节点拉得到的完整引用）。
# 沙箱 Pod 建在哪个命名空间（默认 shadecn-agent-sandbox，要先按 k8s/variants/agent-sandbox.yaml 建好；线上配的是 dev）。
# 那个命名空间必须有准入兜底（Pod Security restricted 或 VAP）：启动自检 dry-run 一个 privileged 的反例，被放行就不启用 agent。
# AGENT_SANDBOX_K8S_NAMESPACE="shadecn-agent-sandbox"
# RuntimeClass（节点装了 gVisor 时如 gvisor）；不配用节点默认的运行时（启动时告警）
# AGENT_SANDBOX_K8S_RUNTIME_CLASS="gvisor"
# 沙箱命名空间里拉镜像的 Secret 名；拉取策略 Always / IfNotPresent / Never（不配用 k8s 的默认）
# AGENT_SANDBOX_K8S_PULL_SECRET="harbor-pull-secret"
# AGENT_SANDBOX_K8S_PULL_POLICY="IfNotPresent"
# 沙箱 Pod 的 nodeSelector：逗号分隔的 key=value（镜像只构建了 arm64 时钉到 arm64 节点上）；格式错 = agent 未启用并写明原因
# AGENT_SANDBOX_K8S_NODE_SELECTOR="kubernetes.io/arch=arm64"
# 连哪个 k8s API：集群内不用配（KUBERNETES_SERVICE_HOST/PORT + ServiceAccount 的 token / ca.crt，token 每次请求重读）。
# 不读 kubeconfig。集群外开发：kubectl proxy（⚠️ 连的是 kubectl 当前的 context）+ 下面两行（token 文件配成空 = 不带 token）；
# 或者直连 API server 时给 token / CA 文件。http:// 只许回环地址。
# AGENT_SANDBOX_K8S_API_URL="http://127.0.0.1:8001"
# AGENT_SANDBOX_K8S_TOKEN_FILE=""
# AGENT_SANDBOX_K8S_CA_FILE=""
# 网关地址默认 http://$POD_IP:$PORT（Deployment 用 Downward API 注入 POD_IP）：runner 必须连回发起它的那个副本，不能走 Service。
# POD_IP="10.42.0.15"
#
# 每个沙箱的资源上限（process 驱动不执行；k8s 不执行 PIDS，由节点 kubelet 的 podPidsLimit 管）：
# CPU 核数、内存 MiB（不给 swap）、PIDs（含线程）、工作目录 tmpfs / 内存型 emptyDir MiB（计入内存）。
# AGENT_SANDBOX_CPUS=1
# AGENT_SANDBOX_MEMORY_MIB=512
# AGENT_SANDBOX_PIDS=128
# AGENT_SANDBOX_DISK_MIB=512
#
# 给 agent 一个 ffmpeg / ffprobe 工具（在 runner 自己的工作目录里跑：命令白名单、不经 shell、超时、输出上限）。默认不开。
# AGENT_SANDBOX_EXEC=1
#
# 沙箱里看到的服务端地址（网关挂在它的 /api/agent-gateway 下）。默认：process → http://127.0.0.1:$PORT（同机）；
# oci → http://host.docker.internal:$PORT（Podman 5 / Docker Desktop 给容器的宿主名；podman machine 上它落到 macOS 的回环地址，
# 服务端只听 127.0.0.1 也连得到。Linux 上的 Docker 没有这个名字，要显式配）；k8s → http://$POD_IP:$PORT（见上）。
# AGENT_GATEWAY_URL="http://127.0.0.1:3000"
#
# 签 run 短令牌（沙箱拿它调网关，10 分钟，可续期）的 HMAC 密钥。不配就由 SESSION_SECRET 派生（不是同一把）。
# AGENT_TOKEN_SECRET=""
#
# 委托授权（Grant，docs/22-agent-sandbox.md）的绝对过期余量：过期时间 = 签发时刻 + 一轮的时长上限 + 它（毫秒，默认 60 秒）。
# AGENT_GRANT_MARGIN_MS=60000
#
# 任务登记、会话槽位、节点占用这些共享表条目的 TTL（毫秒，默认 30 秒）；持有者在 TTL 内续期，进程崩了就自然过期。
# AGENT_LEASE_TTL_MS=30000
# 一个 run 的空闲上限（毫秒，默认 120 秒）：网关上既没有在途请求、也这么久没有新请求，就按超时停下（docs/20 §3.10.8）。
# AGENT_RUN_IDLE_TIMEOUT_MS=120000
# 一个 run（含它的子 run）的总时长上限（毫秒，默认 30 分钟）。
# AGENT_RUN_TOTAL_TIMEOUT_MS=1800000

# ── 画布资源的对象存储（S3 协议，docs/13 §3.7「资源上传」）──────────────────────
# 图片 / 视频节点的上传经后端转存到这里，节点里记的是 S3 原始地址，浏览器直接读 ——
# **桶要对匿名开放读**（s3:GetObject），否则画布上的图是裂的。地址一律 path-style：<endpoint>/<bucket>/<key>。
# BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY 缺一个就是没开上传（上传接口 503），不影响启动。
# 公开地址：节点里存的、浏览器直接读的都是它，必须是浏览器访问得到的地址（不能填集群内的 *.svc）
# S3_ENDPOINT="https://s3.fyl080801.uk"
# 服务端自己发请求（上传、分片、读字节给 agent 看图）用的地址，空 = 和 S3_ENDPOINT 一样。只影响服务端 → S3 这一段，
# 浏览器照旧读 S3_ENDPOINT。k8s 里填集群内网地址（同一个 MinIO、同一个桶）：
# S3_INTERNAL_ENDPOINT="http://minio.minio.svc.cluster.local:9000"
# 签名用的 region，要和服务端配置的一致（MinIO 没改过就是 us-east-1）
# S3_REGION="us-east-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# 单个文件上限（MB）。超过 8MB 的文件自动分片上传（每片 8MB，S3 原生分片上传）
# S3_MAX_UPLOAD_MB=100
# 对象键的根目录。其下是统一的素材目录 assets/<uuid 两级目录>/；
# 几个环境共用一个桶时用它隔开（如 dev/canvas）。设成空串就从桶根开始
# S3_KEY_PREFIX="canvas"
# 建议给桶配一条生命周期规则 AbortIncompleteMultipartUpload（如 1 天）：
# 浏览器半路关掉留下的分片残片要靠它清，否则一直占空间

# ── dev server 的 Host 白名单 ────────────────────────────────────────────────
# 逗号分隔。把本机的 dev server 挂到集群 ingress 后面调试时，进来的 Host 是那个域名，
# 不加进来 Vite 会回一句 403「Blocked request」—— 它长得很像网关或鉴权拒绝，容易查错方向。
# ⚠️ 只加名单、不要改成 allowedHosts: true：那道门挡的是 DNS rebinding（攻击者把自己的域名
# 解析到 127.0.0.1，借受害者的浏览器读本机源码），而 dev server 上挂着任意文件读取能力。
DEV_ALLOWED_HOSTS="demo-dev.fyl080801.uk"
