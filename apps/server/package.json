{
  "name": "@shadecn/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm db:push && tsx watch --exclude '../web/node_modules/.vite-temp/**' index.ts",
    "dev:cluster": "pnpm db:push && node scripts/dev-cluster.mjs",
    "postinstall": "prisma generate || true",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:force": "prisma db push --accept-data-loss",
    "db:studio": "prisma studio",
    "build": "pnpm typecheck && node scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "crossws": "^0.4.10",
    "hono": "^4.13.2",
    "ioredis": "^5.6.1",
    "minidenticons": "^4.2.1",
    "prisma": "^7.9.1",
    "winston": "^3.19.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@shadecn/shared": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
