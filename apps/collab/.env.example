# 协同副本运行目录下的 .env（不进仓库）。dev-front.mjs 让平台和副本共用一个运行目录，所以这一份大家都读。

# 必须和平台相同：副本要认平台发的会话
# PLATFORM_SESSION_SECRET=

# PLATFORM_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/platform
# PLATFORM_REDIS_URL=redis://:password@127.0.0.1:6379

# 握手续期会话时要用
# PLATFORM_OIDC_CLIENT_SECRET=
# PLATFORM_GITHUB_CLIENT_SECRET=
