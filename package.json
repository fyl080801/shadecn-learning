{
  "name": "my-vue-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm db:push && tsx watch server/index.ts",
    "dev:cluster": "pnpm db:push && node scripts/dev-cluster.mjs",
    "postinstall": "prisma generate || true",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:force": "prisma db push --accept-data-loss",
    "db:studio": "prisma studio",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vue-tsc -b && vite build",
    "build:server": "pnpm typecheck:server && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node output/server/index.js",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "preview": "pnpm build && pnpm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project=server",
    "test:client": "vitest run --project=client",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "crossws": "^0.4.10",
    "hono": "^4.13.2",
    "ioredis": "^5.6.1",
    "minidenticons": "^4.2.1",
    "prisma": "^7.9.1",
    "winston": "^3.19.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^10.0.1",
    "@hocuspocus/provider": "^4.6.0",
    "@lucide/vue": "^1.23.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "lib0": "^0.2.117",
    "pinia": "^4.0.3",
    "reka-ui": "^2.9.0",
    "shadcn-vue": "^2.7.4",
    "signals": "^1.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2",
    "three-gpu-pathtracer": "^0.0.24",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.25",
    "vue-router": "^5.0.3",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.1.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7"
  }
}
