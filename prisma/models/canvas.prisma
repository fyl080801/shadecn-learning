// 项目、画布与协同相关的模型（REQ-CANVAS / REQ-COLLAB）。
// 目录约定与写模型的规矩见 auth.prisma 的头注释。

/// 画布的容器与权限边界：成员身份决定画布的访问权。
/// 软删只是过滤条件 —— 不清理、不物理删除、不提供恢复入口。
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// team | personal —— personal 是每人一个的私人空间，里面的画布不走协同（REQ-SOLO）。
  /// 画布的 mode 由它派生，不在 Flow 上另存一份：存两处必然漂移
  kind        String    @default("team")
  /// 个人空间的归属者；团队项目为 null。
  /// unique 就是「一人最多一个个人空间」这条约束本身 —— 不靠代码去保证
  personalOwnerId String? @unique
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy     User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  personalOwner User?           @relation("PersonalSpace", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  /// 分享链接，一个项目最多一条
  invite    ProjectInvite?
  flows     Flow[]

  @@index([deletedAt])
}

/// 项目成员。一个用户在一个项目里最多一条。
/// 创建者的 admin 行是真实写入的，不靠 Project.createdById 隐式推断。
model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  /// admin | member
  role        String   @default("member")
  /// 通过哪个用户的邀请进来的；创建者为 null
  invitedById String?
  joinedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// 分享链接 —— 加入项目的唯一入口。**一个项目只有一条**（projectId 唯一）。
/// token 明文存：它本身就是要发给别人的凭据。
/// 不限使用次数，唯一的闸是 expiresAt；重置就是原地换一个 token，旧链接随即查不到。
model ProjectInvite {
  id          String   @id @default(cuid())
  projectId   String   @unique
  token       String   @unique
  /// 接受后获得的角色，本期恒为 member
  role        String   @default("member")
  createdById String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// 一张画布。内容的事实源是 ydoc（Yjs 状态），
/// graph 是服务端从它派生出来的只读投影。
model Flow {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  /// draft | published | archived
  status      String    @default("draft")
  /// 标签，JSON 字符串数组（SQLite 没有数组类型，两边统一用 String）
  tags        String    @default("[]")
  thumbnail   String?
  /// **画布内容的唯一事实源**：Yjs 文档状态（`Y.encodeStateAsUpdate` 的二进制）。
  /// 为空表示还没被 Yjs 接管过，此时从下面的 graph JSON 现场构建（老数据的迁移入口）。
  ydoc        Bytes?
  /// ydoc 的**只读投影**，服务端在写状态时派生出来。
  /// 列表页、缩略图、将来的只读预览走它，编辑器不再读它（内容从 WebSocket 来）。
  graph       String    @default("{}")
  /// 冗余统计，列表直接展示；和 graph 一起派生
  nodeCount   Int       @default(0)
  edgeCount   Int       @default(0)
  /// 服务端写入 ydoc 的次数。CRDT 不需要乐观锁，这里只是给缓存/展示用的单调计数
  revision    Int       @default(0)
  /// 创建者，仅用于展示，不参与鉴权（鉴权看项目成员身份）
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userStates FlowUserState[]

  @@index([projectId, deletedAt, updatedAt])
}

/// 画布上**属于某个人**的状态：视口（看哪儿、放多大）、以及以后的面板开合、
/// 个人偏好…… 这些是「我怎么看这张画布」，不是画布内容 ——
/// 所以不进 ydoc，一人一份，互不影响。
///
/// 按 key 分区存 JSON 字符串：**加一种要存的东西 = 加一个 key，不用改表**。
/// key 的合法集合与各自的校验在 server/store/flow-types.ts 的
/// FLOW_USER_STATE_PARSERS 里，不认识的 key 一律 400，别当成任意 KV 用。
model FlowUserState {
  id        String   @id @default(cuid())
  flowId    String
  userId    String
  /// 状态分区名，例如 viewport
  key       String
  /// 该分区的值，JSON 字符串（SQLite 没有 Json 类型，两边统一用 String）
  value     String
  updatedAt DateTime @updatedAt

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flowId, userId, key])
  @@index([userId])
}
