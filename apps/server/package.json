{
  "name": "@shadecn/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm db:push && tsx watch --exclude '../web/node_modules/.vite-temp/**' index.ts",
    "dev:cluster": "pnpm db:push && node scripts/dev-cluster.mjs",
    "db:push": "tsx db/sync-cli.ts",
    "db:push:force": "tsx db/sync-cli.ts --force",
    "build": "pnpm typecheck && node scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@hocuspocus/extension-redis": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@hono/node-server": "^2.1.1",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@mikro-orm/sqlite": "7.2.5",
    "crossws": "^0.4.10",
    "hono": "^4.13.2",
    "ioredis": "^5.6.1",
    "minidenticons": "^4.2.1",
    "winston": "^3.19.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@shadecn/agent": "workspace:*",
    "@shadecn/shared": "workspace:*",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
