// 本文件由 scripts/prisma-schema.mjs 生成，不要手改。
// 模型定义在 prisma/models.prisma，改完跑 `pnpm db:schema` 重新生成。

datasource db {
  provider = "postgresql"
}

// Prisma 数据模型 —— 这是唯一的手写来源，SQLite 和 PostgreSQL 共用一份。
//
// 这个文件**不是**完整的 schema：它缺 datasource 块，prisma CLI 不能直接吃。
// `node scripts/prisma-schema.mjs` 会给它套上各自的 datasource，生成
// prisma/schema.sqlite.prisma 和 prisma/schema.postgresql.prisma（两份都提交进仓库，
// prisma.config.ts 按 provider 选一份）。改模型只改这里，然后跑 `pnpm db:schema`。
//
// 模型里不要出现任何 provider 专属的东西（`@db.*` 原生类型、数组、Json、
// enum、citext…），两边生成出来的 client 类型必须一模一样，业务代码才不用分叉。
//
// 生成的 client 输出到 server/generated/prisma，跟着 server/ 一起进镜像。
// 文档：https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

/// 从 Keycloak 的 id_token / userinfo 落下来的用户档案。
/// 用 (issuer, subject) 做唯一键：换了 realm 就是另一个人。
model User {
  id          String    @id @default(cuid())
  issuer      String
  subject     String
  username    String?
  email       String?
  name        String?
  avatarUrl   String?
  /// Keycloak realm/client 角色，存成 JSON 字符串（SQLite 没有数组类型，两边统一用 String）
  roles       String    @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  sessions        Session[]
  memberships     ProjectMember[]
  createdProjects Project[]       @relation("ProjectCreator")
  flowStates      FlowUserState[]

  @@unique([issuer, subject])
}

/// 服务端会话：浏览器只拿到一个随机 token（httpOnly cookie），
/// 这里存的 id 是那个 token 的 sha256，token 本身不落库。
model Session {
  id               String    @id
  userId           String
  accessToken      String
  refreshToken     String?
  idToken          String?
  /// access_token 过期时间，到点用 refresh_token 续
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  /// Keycloak 的 session_state，用于后端发起的单点登出
  sessionState     String?
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 一次授权请求的临时凭据（state / nonce / PKCE code_verifier）。
/// 回调时一次性消费掉，防重放；过期的靠 sweep 清理。
model AuthRequest {
  id           String   @id @default(cuid())
  state        String   @unique
  nonce        String
  codeVerifier String
  /// 登录成功后要跳回的前端地址（只允许站内路径）
  redirectTo   String   @default("/")
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

/// 画布的容器与权限边界：成员身份决定画布的访问权。
/// 软删只是过滤条件 —— 不清理、不物理删除、不提供恢复入口。
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  /// 分享链接，一个项目最多一条
  invite    ProjectInvite?
  flows     Flow[]

  @@index([deletedAt])
}

/// 项目成员。一个用户在一个项目里最多一条。
/// 创建者的 admin 行是真实写入的，不靠 Project.createdById 隐式推断。
model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  /// admin | member
  role        String   @default("member")
  /// 通过哪个用户的邀请进来的；创建者为 null
  invitedById String?
  joinedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// 分享链接 —— 加入项目的唯一入口。**一个项目只有一条**（projectId 唯一）。
/// token 明文存：它本身就是要发给别人的凭据。
/// 不限使用次数，唯一的闸是 expiresAt；重置就是原地换一个 token，旧链接随即查不到。
model ProjectInvite {
  id          String   @id @default(cuid())
  projectId   String   @unique
  token       String   @unique
  /// 接受后获得的角色，本期恒为 member
  role        String   @default("member")
  createdById String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// 一张画布。graph 是全量快照（FlowGraph 的 JSON 字符串），
/// 操作日志在 FlowOperation 里 —— 读走快照，日志作为可回放的旁路。
model Flow {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  /// draft | published | archived
  status      String    @default("draft")
  /// 标签，JSON 字符串数组（SQLite 没有数组类型，两边统一用 String）
  tags        String    @default("[]")
  thumbnail   String?
  graph       String    @default("{}")
  /// 冗余统计，列表直接展示，commit 时一并更新
  nodeCount   Int       @default(0)
  edgeCount   Int       @default(0)
  /// 修订号，每提交一个事务 +1；客户端提交时带 baseRevision 做乐观锁
  revision    Int       @default(0)
  /// 创建者，仅用于展示，不参与鉴权（鉴权看项目成员身份）
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operations FlowOperation[]
  userStates FlowUserState[]

  @@index([projectId, deletedAt, updatedAt])
}

/// 画布上**属于某个人**的状态：视口（看哪儿、放多大）、以及以后的面板开合、
/// 个人偏好…… 这些是「我怎么看这张画布」，不是画布内容 ——
/// 所以既不进 graph 快照，也不进操作日志，一人一份，互不影响。
///
/// 按 key 分区存 JSON 字符串：**加一种要存的东西 = 加一个 key，不用改表**。
/// key 的合法集合与各自的校验在 server/store/flow-types.ts 的
/// FLOW_USER_STATE_PARSERS 里，不认识的 key 一律 400，别当成任意 KV 用。
model FlowUserState {
  id        String   @id @default(cuid())
  flowId    String
  userId    String
  /// 状态分区名，例如 viewport
  key       String
  /// 该分区的值，JSON 字符串（SQLite 没有 Json 类型，两边统一用 String）
  value     String
  updatedAt DateTime @updatedAt

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flowId, userId, key])
  @@index([userId])
}

/// 操作日志，只追加、不修改、不删除（删画布时级联）。
/// 撤销也是一条新记录（kind=undo），日志永远只往前走。
///
/// 时间一律是 UTC epoch 毫秒的整数（BigInt），不是 DateTime：
/// 协同时要把不同客户端的操作排到同一条时间轴上，数值可以直接比大小，
/// 不受时区、字符串格式、序列化精度影响。
model FlowOperation {
  id        String   @id @default(cuid())
  flowId    String
  /// 画布内自增序号，从 1 开始，提交后与 Flow.revision 对齐
  seq       Int
  /// 客户端事务 id，用于重试幂等
  txId      String
  /// do | undo | redo
  kind      String   @default("do")
  label     String
  /// FlowOp[] 的 JSON 字符串
  ops       String
  actorId   String?
  /// 客户端产生这次事务的时刻（UTC epoch ms），由客户端上报
  clientTs  BigInt
  /// 服务端落库时刻（UTC epoch ms）—— 客户端的钟不可信，排序以它为准
  serverTs  BigInt

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, seq])
  @@unique([flowId, txId])
  @@index([flowId, seq])
}
