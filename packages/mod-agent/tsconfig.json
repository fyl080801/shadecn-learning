{
  /*
   * 画布 agent 的宿主侧能力包（REQ-AGENT / REQ-MODULES）：runtime 装配、委托授权、沙箱驱动接线、运行登记、节点占用、模型表、agent 定义。编排引擎本身在 @shadecn/agent。
   * 纯服务端：apps/server 以源码形式 import，再由 esbuild 内联进 bundle。
   * 配置照 apps/server / packages/agent 的来（Node 类型 + ES2023）。**它不 import apps/server，也不读 process.env；底座的东西只经 @shadecn/server-kit 和宿主交进来的端口拿**。
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mod-agent.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
