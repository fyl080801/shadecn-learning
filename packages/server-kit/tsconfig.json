{
  /*
   * 服务端底座的运行时库（REQ-MODULES，docs/28）：模块内核、共享层、总线、权限撤销信号。
   * 纯服务端：apps/server 和各个能力包（packages/mod-*）以源码形式 import，再由 esbuild 内联进 bundle。
   * 配置照 apps/server / packages/agent 的来（Node 类型 + ES2023）。**它不 import apps/server，也不读 process.env**。
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server-kit.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
