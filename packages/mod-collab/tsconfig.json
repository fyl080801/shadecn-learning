{
  /*
   * 协同能力包（REQ-COLLAB / REQ-MODULES）：Hocuspocus 服务端、落库、配额、awareness、写入闸门，加对外契约（contract）。
   * 纯服务端：apps/server 以源码形式 import，再由 esbuild 内联进 bundle。
   * 配置照 apps/server / packages/agent 的来（Node 类型 + ES2023）。**它不 import apps/server，也不读 process.env；底座的东西只经 @shadecn/server-kit 和宿主交进来的端口拿**。
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mod-collab.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
