{
  "name": "my-vue-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @shadecn/server dev",
    "dev:cluster": "pnpm --filter @shadecn/server dev:cluster",
    "dev:platform": "pnpm --filter @learning/platform dev",
    "dev:front": "pnpm --filter @learning/collab-service dev:front",
    "db:push": "pnpm --filter @shadecn/server db:push",
    "db:push:force": "pnpm --filter @shadecn/server db:push:force",
    "build": "node scripts/build-all.mjs",
    "build:client": "pnpm --filter @shadecn/web build",
    "build:server": "pnpm --filter @shadecn/server build",
    "build:sandbox": "pnpm --filter @shadecn/agent-sandbox build",
    "build:platform": "pnpm --filter @shadecn/web build && pnpm --filter @learning/platform build",
    "build:collab-service": "pnpm --filter @learning/collab-service build",
    "build:sandbox-image": "pnpm --filter @shadecn/agent-sandbox build:image",
    "start": "NODE_ENV=production node --import ./apps/server/scripts/local-start.mjs output/server/index.js",
    "start:platform": "pnpm --filter @learning/platform start",
    "typecheck:server": "pnpm --filter @shadecn/server typecheck",
    "typecheck:shared": "pnpm --filter @shadecn/shared typecheck",
    "typecheck:agent": "pnpm --filter @shadecn/agent typecheck",
    "typecheck:agent-sandbox": "pnpm --filter @shadecn/agent-sandbox typecheck",
    "typecheck:platform": "pnpm --filter @learning/platform typecheck",
    "typecheck:collab-service": "pnpm --filter @learning/collab-service typecheck",
    "typecheck:config": "pnpm --filter @learning/config typecheck",
    "typecheck:learning-web": "pnpm --filter @learning/web typecheck",
    "typecheck:contracts": "pnpm --filter @learning/contracts typecheck",
    "typecheck:cluster": "pnpm --filter @learning/cluster typecheck",
    "typecheck:foundation": "pnpm --filter @learning/foundation typecheck",
    "typecheck:data-access": "pnpm --filter @learning/data-access typecheck",
    "typecheck:session": "pnpm --filter @learning/session typecheck",
    "typecheck:canvas": "pnpm --filter @learning/canvas typecheck",
    "typecheck:collab": "pnpm --filter @learning/collab typecheck",
    "typecheck:storage": "pnpm --filter @learning/storage typecheck",
    "typecheck:server-kit": "pnpm --filter @shadecn/server-kit typecheck",
    "typecheck:server-core": "pnpm --filter @shadecn/server-core typecheck",
    "typecheck:mod-auth": "pnpm --filter @shadecn/mod-auth typecheck",
    "typecheck:mod-canvas": "pnpm --filter @shadecn/mod-canvas typecheck",
    "typecheck:mod-collab": "pnpm --filter @shadecn/mod-collab typecheck",
    "typecheck:mod-storage": "pnpm --filter @shadecn/mod-storage typecheck",
    "typecheck:mod-agent": "pnpm --filter @shadecn/mod-agent typecheck",
    "typecheck:mod-apps": "pnpm --filter @shadecn/mod-apps typecheck",
    "preview": "pnpm build && pnpm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project=server",
    "test:client": "vitest run --project=client",
    "test:shared": "vitest run --project=shared",
    "test:agent": "vitest run --project=agent",
    "test:agent-sandbox": "vitest run --project=agent-sandbox",
    "test:platform": "vitest run --project=platform",
    "test:collab-service": "vitest run --project=collab-service",
    "test:config": "vitest run --project=config",
    "test:learning-web": "vitest run --project=learning-web",
    "test:contracts": "vitest run --project=contracts",
    "test:cluster": "vitest run --project=cluster",
    "test:foundation": "vitest run --project=foundation",
    "test:data-access": "vitest run --project=data-access",
    "test:session": "vitest run --project=session",
    "test:canvas": "vitest run --project=canvas",
    "test:collab": "vitest run --project=collab",
    "test:storage": "vitest run --project=storage",
    "test:server-kit": "vitest run --project=server-kit",
    "test:server-core": "vitest run --project=server-core",
    "test:mod-auth": "vitest run --project=mod-auth",
    "test:mod-canvas": "vitest run --project=mod-canvas",
    "test:mod-collab": "vitest run --project=mod-collab",
    "test:mod-storage": "vitest run --project=mod-storage",
    "test:mod-agent": "vitest run --project=mod-agent",
    "test:mod-apps": "vitest run --project=mod-apps",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
